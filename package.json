{
  "name": "astro-website-starter",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "bun": ">=1.4.3",
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && bun run scripts/precompress.mjs",
    "preview": "astro preview",
    "check": "bun scripts/verify-source.mjs",
    "prepare": "husky",
    "astro": "astro",
    "verify": "bun run check && bun run format:check && bun run lint && bun run typecheck && bun run build && bun run check:output && bun run test",
    "check:output": "bun run scripts/verify-output.ts",
    "test": "bun test tests",
    "typecheck": "astro check --minimumFailingSeverity hint && tsc --noEmit",
    "tscheck": "bun run typecheck",
    "lint": "bun run lint:js && bun run lint:css",
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.{css,astro}\" --max-warnings 0",
    "lint:fix": "bun run lint:js --fix && bun run lint:css --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "html-minifier-terser": "^7.2.0",
    "husky": "^9.1.7",
    "lightningcss": "^1.33.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0"
  },
  "private": true
}
