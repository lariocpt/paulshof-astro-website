---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { navItems, site } from '../site';

// Static hosts serve dist/404.html for missing routes. It stays out of the sitemap and
// carries noindex, because a soft 404 that looks like content is worse than a real 404.

const entry = await getEntry('pages', 'not-found');
if (!entry) throw new Error('Missing content: src/content/pages/not-found.mdx');
---

<Layout title="Page not found" description={entry.data.description} noindex>
  <PageHeader entry={entry} />

  <nav class="container-page not-found-nav" aria-label="Pages">
    <ul>
      {navItems.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
        </li>
      ))}
    </ul>
    <p class="not-found-call">
      Or phone <a href={site.phone.href}>{site.phone.label}</a>
      {' — '}
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
  </nav>
</Layout>

<style>
  .not-found-nav {
    padding-block: var(--space-6) var(--space-24);
  }

  .not-found-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-7);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .not-found-nav a {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--color-accent-ink);
    text-decoration: underline;
    text-underline-offset: 0.1875rem;
  }

  .not-found-call {
    padding-block-start: var(--space-8);
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
  }
</style>
