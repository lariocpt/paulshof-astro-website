---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import PosterCTA from '../components/PosterCTA.astro';

const entry = await getEntry('pages', 'approach');
if (!entry) throw new Error('Missing content: src/content/pages/approach.mdx');

const roles = (await getCollection('principles')).sort(
  (a, b) => a.data.order - b.data.order,
);
const renderedRoles = await Promise.all(
  roles.map(async (r) => ({ entry: r, ...(await render(r)) })),
);

const week = (await getCollection('process')).sort(
  (a, b) => a.data.order - b.data.order,
);
const renderedWeek = await Promise.all(
  week.map(async (w) => ({ entry: w, ...(await render(w)) })),
);
---

<Layout
  title="Approach"
  description={entry.data.description}
  breadcrumbs={[{ label: 'Approach', href: '/approach/' }]}
>
  <PageHeader entry={entry} />

  <Section id="roles" eyebrow="Example principles">
    <div class="roles">
      {renderedRoles.map(({ entry: role, Content }, i) => (
        <div class="role" data-reveal data-reveal-delay={`${i * 80}ms`}>
          <h3>{role.data.title}</h3>
          <Content />
        </div>
      ))}
    </div>
  </Section>

  <Section id="week" eyebrow="Example process">
    <dl class="week">
      {renderedWeek.map(({ entry: day, Content }, i) => (
        <div class="week-row" data-reveal data-reveal-delay={`${i * 60}ms`}>
          <dt>{day.data.day}</dt>
          <dd>
            <Content />
          </dd>
        </div>
      ))}
    </dl>
  </Section>

  <PosterCTA />
</Layout>

<style>
  .roles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-12);
  }

  .role h3 {
    font-size: 1.3125rem;
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: var(--border-strong) solid var(--color-divider);
  }

  .role :global(ul) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .role :global(li) {
    padding: var(--space-3) 0 var(--space-3) var(--space-5);
    font-size: 0.9375rem;
    line-height: 1.7;
    border-bottom: var(--border-width) solid var(--color-divider);
    position: relative;
    color: color-mix(in srgb, var(--color-text) 80%, transparent);
  }

  .role :global(li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 1.3125rem;
    width: 0.5rem;
    height: 0.125rem;
    background: var(--color-accent);
  }

  .week {
    margin: 0;
  }

  .week-row {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: var(--space-6);
    align-items: baseline;
    padding: var(--space-5) 0;
    border-top: var(--border-strong) solid var(--color-divider);
  }

  .week-row dt {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.0625rem;
  }

  .week-row dd {
    margin: 0;
  }

  .week-row dd :global(p) {
    margin: 0;
    font-size: 0.96875rem;
    line-height: 1.75;
    color: color-mix(in srgb, var(--color-text) 78%, transparent);
  }

  @media (max-width: 51.25rem) {
    .roles {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .week-row {
      grid-template-columns: 1fr;
      gap: var(--space-one-half);
    }
  }
</style>
