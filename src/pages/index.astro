---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import StackBand from '../components/StackBand.astro';
import OutcomeStats from '../components/OutcomeStats.astro';
import ServiceList from '../components/ServiceList.astro';
import PullQuote from '../components/PullQuote.astro';
import PosterCTA from '../components/PosterCTA.astro';
import { site } from '../site';

const hero = await getEntry('pages', 'hero');
if (!hero) throw new Error('Missing content: src/content/pages/hero.mdx');
---

<Layout title="Home" description={site.description}>
  <Hero entry={hero} />

  <Section id="stack" eyebrow="How the starter is organized">
    <StackBand />
  </Section>

  <Section id="outcomes" eyebrow="The foundations">
    <OutcomeStats />
  </Section>

  <Section id="services" eyebrow="Example services">
    <ServiceList />
  </Section>

  <PullQuote />
  <PosterCTA />
</Layout>
