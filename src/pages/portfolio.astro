---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import Section from '../components/Section.astro';
import ToolList from '../components/ToolList.astro';
import PosterCTA from '../components/PosterCTA.astro';

const entry = await getEntry('pages', 'portfolio');
if (!entry) throw new Error('Missing content: src/content/pages/portfolio.mdx');
---

<Layout
  title="Portfolio"
  description={entry.data.description}
  breadcrumbs={[{ label: 'Portfolio', href: '/portfolio/' }]}
>
  <PageHeader entry={entry} />

  <div class="page-body">
    <ProjectGrid headingLevel={2} />
  </div>

  <Section id="tools" eyebrow="Useful references">
    <ToolList />
  </Section>

  <PosterCTA />
</Layout>

<style>
  .page-body {
    padding-bottom: var(--space-18);
  }
</style>
