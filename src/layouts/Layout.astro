---
import type { ImageMetadata } from 'astro';
import { ClientRouter } from 'astro:transitions';
import headScript from '../scripts/head-init.js?raw';
import Seo from '../components/Seo.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../site';
import '../styles/global.css';

interface Crumb {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  breadcrumbs?: Crumb[];
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { title, description, breadcrumbs, schema, noindex, image, imageAlt } =
  Astro.props;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!--
      Unlocking script, applied before the stylesheet and before first paint.

      This must be inline and synchronous. A bundled module script is deferred, which
      means the browser would paint revealed content first and only then hide it behind
      the scroll-reveal rules - the worst possible flash for a page being read.

      `is:inline` keeps Astro from processing and hoisting it.
    -->
    <script is:inline set:html={headScript} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="icon" href="/icon-512.png" sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta
      name="theme-color"
      content={site.theme.light}
      media="(prefers-color-scheme: light)"
    />

    <!-- Only the latin subset: it covers the entire site's copy, so preloading the other
		     two would spend bandwidth on glyphs that are never drawn. -->
    <link
      rel="preload"
      href="/fonts/archivo-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link
      rel="preload"
      href="/fonts/fraunces-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <Seo
      title={title}
      description={description}
      breadcrumbs={breadcrumbs}
      schema={schema}
      noindex={noindex}
      image={image}
      imageAlt={imageAlt}
    />

    <ClientRouter />
  </head>

  <body>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />

    <script>
      // One observer for every [data-reveal] on the page. Per-element observers would be
      // the obvious shape and would also mean one more observer for every card on the
      // portfolio page, which has thirty-odd.
      //
      // Guarded by the same media query as the CSS: if the user prefers reduced motion
      // the elements are already at their final state, so observing them would do
      // nothing but cost work.
      const SELECTOR =
        '[data-reveal]:not([data-revealed]), [data-reveal-rule]:not([data-revealed])';
      let observer: IntersectionObserver | undefined;
      let deadline: ReturnType<typeof setTimeout> | undefined;

      function cleanupReveals() {
        observer?.disconnect();
        clearTimeout(deadline);
      }

      function revealAll() {
        for (const el of document.querySelectorAll(SELECTOR)) {
          el.setAttribute('data-revealed', '');
        }
      }

      function wireReveals() {
        cleanupReveals();
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches)
          return;

        const targets = document.querySelectorAll(SELECTOR);
        if (targets.length === 0) return;

        // These elements start invisible, so any failure below is a page that never
        // shows its content. Every branch out of here ends in something visible.
        if (!('IntersectionObserver' in window)) {
          revealAll();
          return;
        }

        try {
          observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.setAttribute('data-revealed', '');
                // Reveal is one-way. Re-hiding on scroll-out makes a long page
                // flicker every time it is scrolled back through.
                observer?.unobserve(entry.target);
              }
            },
            { rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
          );

          for (const target of targets) {
            // CSSOM property updates preserve staggered reveals under CSP without
            // authorizing inline style attributes in the generated HTML.
            if (target instanceof HTMLElement && target.dataset.revealDelay) {
              target.style.setProperty(
                '--reveal-delay',
                target.dataset.revealDelay,
              );
            }
            observer.observe(target);
          }
        } catch {
          revealAll();
          return;
        }

        // Failsafe. The observer above is the normal path, but "content is hidden until
        // an async callback fires" has no acceptable failure mode — a headless renderer
        // that never ticks intersection, a print stylesheet, an unexpected exception in
        // another script that halts the queue. After this long, show everything that is
        // still hidden regardless of where the viewport is.
        deadline = setTimeout(revealAll, 2500);
      }

      document.addEventListener('astro:before-swap', cleanupReveals);
      document.addEventListener('astro:page-load', wireReveals);
    </script>
  </body>
</html>
