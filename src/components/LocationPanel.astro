---
import { site } from '../site';

// Where the property is and how to get there, without a single third-party request.
//
// The CSP has no frame-src, so default-src 'self' would block a Google Maps or Waze iframe
// even behind a click-to-load facade — and an embed also phones home before anyone consented.
// The chosen path is no embed at all: the address, the turn-by-turn directions the property
// published, and labelled external links the guest chooses to open. Nothing loads and nothing
// is requested until a link is pressed. The map links carry the address so they arrive at the
// right pin, not a blank search box.

interface Props {
  heading?: string;
  /** Turn-by-turn steps as the property publishes them. Rendered as an ordered list. */
  steps?: string[];
  /** Where the steps start from, as the source labels them. */
  routeLabel?: string;
  /** The property's own search advice, shown beside the map links. */
  searchNote?: string;
}

const {
  heading = 'Where to find us',
  steps = [],
  routeLabel,
  searchNote,
} = Astro.props;

const query = encodeURIComponent(site.address.full);
const links = [
  {
    label: 'Open in Google Maps',
    href: `https://www.google.com/maps/search/?api=1&query=${query}`,
  },
  {
    label: 'Open in Waze',
    href: `https://waze.com/ul?q=${query}&navigate=yes`,
  },
];
---

<section
  class="location-panel container-page"
  aria-labelledby="location-heading"
>
  <div class="location-inner">
    <div class="location-main">
      <h2 id="location-heading">{heading}</h2>
      <address class="location-address">
        {site.address.first}
        <br />
        {site.address.locality}, {site.address.city}
        {site.address.postalCode}
      </address>

      {steps.length > 0 && (
        <div class="location-directions">
          <h3>{routeLabel ?? 'Directions'}</h3>
          <ol class="location-steps">
            {steps.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        </div>
      )}
    </div>

    <div class="location-actions">
      <h3 class="location-actions-heading">Get directions</h3>
      {searchNote && <p class="location-search-note">{searchNote}</p>}
      <ul class="location-links">
        {links.map((link) => (
          <li>
            <a href={link.href} rel="noopener">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <p class="location-note">
        Links open the map service you choose; this page loads no map itself.
      </p>
    </div>
  </div>
</section>

<style>
  .location-panel {
    padding-block: var(--space-12) var(--space-14);
  }

  .location-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .location-panel h2 {
    margin: 0 0 var(--space-4);
    color: var(--color-accent-ink);
  }

  .location-address {
    font-style: normal;
    font-size: var(--text-title-sm);
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .location-directions {
    padding-block-start: var(--space-6);
    max-inline-size: var(--measure-prose);
  }

  .location-directions h3 {
    font-size: var(--text-title-sm);
  }

  .location-steps {
    margin: var(--space-3) 0 0;
    padding-inline-start: var(--space-5);
    list-style: decimal;
  }

  .location-steps li {
    margin-block-end: var(--space-2);
    line-height: var(--leading-prose);
  }

  .location-actions {
    padding: var(--space-6);
    background: var(--color-surface);
    border-radius: var(--radius-md);
  }

  .location-actions-heading {
    margin: 0 0 var(--space-4);
    font-size: var(--text-xs);
    font-family: var(--font-sans);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .location-links {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .location-links a {
    color: var(--color-accent-ink);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.1875rem;
  }

  .location-search-note {
    margin: 0 0 var(--space-4);
    font-size: var(--text-body-sm);
    color: var(--color-text);
  }

  .location-note {
    margin: var(--space-4) 0 0;
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
  }

  @media (min-width: 52rem) {
    .location-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
      gap: var(--space-12);
    }
  }
</style>
