---
import { getCollection, render } from 'astro:content';

interface Props {
  /** 2 when this grid is the page's top-level content, 3 when nested under a section. */
  headingLevel?: 2 | 3;
}

const { headingLevel = 3 } = Astro.props;
const H = `h${headingLevel}` as const;

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const rendered = await Promise.all(
  projects.map(async (entry) => ({ entry, ...(await render(entry)) })),
);
---

<ul class="projects">
  {rendered.map(({ entry, Content }, i) => (
    <li>
      <article
        class="project"
        data-reveal
        data-reveal-delay={`${(i % 2) * 70}ms`}
        aria-labelledby={`project-${entry.id}`}
      >
        <p class="project-kind">{entry.data.kind}</p>
        <H id={`project-${entry.id}`} class="project-name">
          {entry.data.name}
        </H>
        <div class="project-copy">
          <Content />
        </div>
        {entry.data.links && (
          <ul class="project-links">
            {entry.data.links.map((l) => (
              <li>
                <a href={l.href} rel="noopener">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        )}
        <p class="project-stack">{entry.data.stack}</p>
      </article>
    </li>
  ))}
</ul>

<style>
  /* Mirrors the footer's link row: flex, no icons, no bullets. Sits above
     .project-stack, so the stack line stays the card's last element. */
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    list-style: none;
    margin: 0 0 0.875rem;
    padding: 0;
    font-size: var(--text-sm);
  }
  .project-links a {
    color: var(--color-accent-ink);
  }
  .projects {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-half);
    margin: 0;
    padding: 0;
    list-style: none;
    /* The 0.125rem gap plus a divider-coloured ground draws the grid rules, so the cards need
     * no borders of their own and the lines never double up at the seams. */
    background: var(--color-divider);
    border-block: var(--border-strong) solid var(--color-divider);
  }

  .project {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-7);
    background: var(--color-bg);
  }

  .project-kind {
    margin: 0 0 0.625rem;
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-ink);
  }

  .project-name {
    font-size: 1.3125rem;
    margin: 0 0 var(--space-3);
    letter-spacing: -0.01em;
  }

  .project-copy {
    flex: 1;
  }

  .project-copy :global(p) {
    font-size: 0.90625rem;
    line-height: 1.75;
    margin: 0;
    color: color-mix(in srgb, var(--color-text) 76%, transparent);
  }

  .project-stack {
    margin: var(--space-5) 0 0;
    font-size: 0.78125rem;
    font-family: var(--font-mono);
    color: color-mix(in srgb, var(--color-text) 78%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .project {
      transition:
        background-color 200ms ease,
        box-shadow 240ms var(--ease-out-quint);
    }

    .project:hover {
      background: var(--color-surface);
      box-shadow: var(--shadow-md);
    }
  }

  @media (max-width: 51.25rem) {
    .projects {
      grid-template-columns: 1fr;
    }
  }
</style>
