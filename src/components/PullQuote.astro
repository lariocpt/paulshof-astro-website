---
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'pull-quote');
if (!entry)
  throw new Error('Missing content: src/content/pages/pull-quote.mdx');
const { Content } = await render(entry);
---

<section class="quote-section" aria-label="Pull quote">
  <div class="container-page">
    <figure data-reveal>
      <blockquote>
        <Content />
      </blockquote>
      {entry.data.cite && <figcaption>{entry.data.cite}</figcaption>}
    </figure>
  </div>
</section>

<style>
  .quote-section {
    padding-block: var(--space-10) var(--space-18);
  }

  figure {
    margin: 0;
  }

  blockquote {
    margin: 0;
  }

  blockquote :global(p) {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(1.5rem, 3.4vw, 2.125rem);
    line-height: 1.24;
    letter-spacing: -0.015em;
    max-width: 34ch;
    margin: 0;
  }

  figcaption {
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-text) 78%, transparent);
  }
</style>
