---
import { getCollection, render } from 'astro:content';

interface Props {
  /** 2 when this list is the page's top-level content, 3 when nested under a section. */
  headingLevel?: 2 | 3;
}

const { headingLevel = 3 } = Astro.props;
const H = `h${headingLevel}` as const;

const cases = (await getCollection('cases')).sort(
  (a, b) => a.data.order - b.data.order,
);
const rendered = await Promise.all(
  cases.map(async (entry) => ({ entry, ...(await render(entry)) })),
);
---

<div class="cases">
  {rendered.map(({ entry, Content }, i) => (
    <article
      class="case"
      data-reveal
      data-reveal-delay={`${i * 70}ms`}
      aria-labelledby={`case-${entry.id}`}
    >
      <p class="case-sector">{entry.data.sector}</p>
      <div>
        <H id={`case-${entry.id}`} class="case-title">
          {entry.data.title}
        </H>
        <div class="case-copy">
          <Content />
        </div>
        <p class="case-stack">{entry.data.stack}</p>
      </div>
    </article>
  ))}
</div>

<style>
  .case {
    display: grid;
    grid-template-columns: minmax(0, 18.75rem) minmax(0, 1fr);
    gap: var(--space-6) var(--space-14);
    padding: var(--space-8) 0;
    border-top: var(--border-strong) solid var(--color-divider);
  }

  .case-sector {
    margin: 0;
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-ink);
  }

  .case-title {
    font-size: var(--text-title);
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-3);
    max-width: 32ch;
  }

  .case-copy :global(p) {
    font-size: 0.96875rem;
    line-height: 1.8;
    margin: 0;
    max-width: 62ch;
    color: color-mix(in srgb, var(--color-text) 78%, transparent);
  }

  .case-stack {
    margin: var(--space-4) 0 0;
    font-size: 0.78125rem;
    font-family: var(--font-mono);
    color: color-mix(in srgb, var(--color-text) 78%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .case {
      transition: border-color 200ms ease;
    }
    .case:hover {
      border-top-color: var(--color-accent);
    }
  }

  @media (max-width: 56.25rem) {
    .case {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
</style>
