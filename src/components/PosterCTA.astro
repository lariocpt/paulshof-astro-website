---
import { site } from '../site';
import { getEntry } from 'astro:content';

const entry = await getEntry('pages', 'cta');
if (!entry) throw new Error('Missing content: src/content/pages/cta.mdx');
---

<!-- The accent-field close. This is the one full-bleed element on the site, so it carries the
     view transition name: it is the thing the eye is on when a navigation starts. -->
<section class="poster" aria-labelledby="poster-heading">
  <div class="container-page poster-inner">
    <h2 id="poster-heading">{entry.data.heading}</h2>
    <a class="btn poster-btn" href="/contact/">
      {site.ui.contact}
    </a>
  </div>
</section>

<style>
  .poster {
    view-transition-name: poster;
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .poster-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: var(--space-18);
  }

  .poster h2 {
    font-size: clamp(1.75rem, 1.25rem + 2vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 20ch;
  }

  /* Reversed out of the accent field: the page's own bg becomes the button, and the accent
     becomes its text. Deliberately not .btn-primary, which would be an incompatible foreground on the accent surface. */
  .poster-btn {
    background: var(--color-on-accent);
    color: var(--color-on-accent-inverse);
    font-size: 0.9375rem;
    padding: var(--space-3) var(--space-5);
  }

  .poster-btn:hover {
    filter: brightness(1.06);
  }

  .poster :global(.poster-btn:focus-visible) {
    outline-color: var(--color-on-accent);
  }

  @media (max-width: 45rem) {
    .poster-inner {
      padding-block: var(--space-12);
    }
  }
</style>
