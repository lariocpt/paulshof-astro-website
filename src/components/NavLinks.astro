---
import { navItems } from '../site';

// One ordered route list, shared by the header strip, the mobile sheet and the footer, so
// "current page" is computed the same way everywhere. Entries exist only for routes that
// are actually built, which the built-output check enforces link by link.

interface Props {
  class?: string;
}

const { class: className, ...rest } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<ul class={className} {...rest}>
  {navItems.map((item) => (
    <li>
      <a
        href={item.href}
        aria-current={
          path === (item.href.replace(/\/+$/, '') || '/') ? 'page' : undefined
        }
      >
        {item.label}
      </a>
    </li>
  ))}
</ul>
