---
import { getCollection } from 'astro:content';

const career = (await getCollection('career')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<ol class="career">
  {career.map((entry, i) => (
    <li class="career-row" data-reveal data-reveal-delay={`${i * 50}ms`}>
      {/* datetime carries the machine-readable year; the visible text keeps the
				    design's en-dashed range, which is not a valid datetime value. */}
      <time class="career-years" datetime={String(entry.data.startYear)}>
        {entry.data.years}
      </time>
      <p class="career-role">{entry.data.role}</p>
      <p class="career-org">{entry.data.org}</p>
    </li>
  ))}
</ol>

<style>
  .career {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .career-row {
    display: grid;
    grid-template-columns: 8.125rem minmax(0, 18.75rem) minmax(0, 1fr);
    gap: var(--space-2) var(--space-8);
    align-items: baseline;
    padding: var(--space-4) 0;
    border-top: var(--border-width) solid var(--color-divider);
  }

  .career-years {
    font-size: var(--text-body-sm);
    font-variant-numeric: tabular-nums;
    color: color-mix(in srgb, var(--color-text) 78%, transparent);
  }

  .career-role {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 0.9375rem;
  }

  .career-org {
    margin: 0;
    font-size: 0.90625rem;
    color: color-mix(in srgb, var(--color-text) 74%, transparent);
  }

  @media (max-width: 45rem) {
    .career-row {
      grid-template-columns: 1fr;
      gap: var(--space-half);
    }
  }
</style>
