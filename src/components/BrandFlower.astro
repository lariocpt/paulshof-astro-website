---
// The crane-flower mark as an inline SVG badge. Decorative: the accessible name is
// carried by the adjacent wordmark (and the header link's aria-label), so this is
// aria-hidden. Inline vector, so it stays crisp at any zoom and needs no image file
// and no CSP allowance. Colours come from theme tokens, never literals.
---

<span class="brand-mark" aria-hidden="true">
  <svg viewBox="0 0 512 512" width="32" height="32" focusable="false">
    <g fill="currentColor">
      <path d="M154.50,143.50L159.50,143.50L224.50,210.50L239.50,231.50L246.50,245.50L252.50,265.50L297.50,232.50L342.50,191.50L386.50,146.50L391.50,146.50L391.50,151.50L386.50,161.50L332.50,250.50L312.50,275.50L286.50,299.50L272.50,309.50L258.50,326.50L263.50,436.50L238.50,436.50L242.50,344.50L242.50,326.50L238.50,318.50L226.50,306.50L203.50,294.50L183.50,280.50L163.50,261.50L146.50,240.50L98.50,170.50L98.50,164.50L102.50,164.50L151.50,207.50L193.50,235.50L162.50,167.50L154.50,144.50Z" />
      <path d="M245.50,76.50L250.50,76.50L251.50,82.50L259.50,163.50L266.50,206.50L266.50,211.50L261.50,223.50L257.50,251.50L252.50,251.50L249.50,247.50L233.50,211.50L245.50,77.50Z" />
      <path d="M349.50,113.50L353.50,113.50L351.50,124.50L302.50,222.50L273.50,248.50L266.50,249.50L265.50,229.50L271.50,210.50L348.50,114.50Z" />
    </g>
  </svg>
</span>

<style>
  .brand-mark {
    display: grid;
    flex: none;
    place-items: center;
    inline-size: 2.625rem;
    block-size: 2.625rem;
    color: var(--color-accent-on-fill);
    background: var(--color-accent-fill);
    border-radius: var(--radius-sm);
  }

  .brand-mark svg {
    inline-size: 74%;
    block-size: 74%;
  }
</style>
