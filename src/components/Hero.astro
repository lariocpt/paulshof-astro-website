---
import { site } from '../site';
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import logo from '../assets/example/site-preview.png';

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// The headline is one sentence per line in the design, with the last line in accent. Splitting
// on the sentence boundary keeps the copy a single editable string in the MDX rather than
// three frontmatter fields that can drift out of order.
const lines = (entry.data.heading ?? '').split(/(?<=\.)\s+/).filter(Boolean);
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container-page">
    <div class="hero-copy">
      <h1 id="hero-heading">
        {lines.map((line, i) => (
          <span
            class:list={[
              'hero-line',
              { 'hero-line-accent': i === lines.length - 1 },
            ]}
            data-reveal
            data-reveal-delay={`${i * 90}ms`}
          >
            {line}
          </span>
        ))}
      </h1>

      <div
        class="hero-lead"
        data-reveal
        data-reveal-delay={`${lines.length * 90}ms`}
      >
        <Content />
      </div>

      <div
        class="hero-actions"
        data-reveal
        data-reveal-delay={`${(lines.length + 1) * 90}ms`}
      >
        <a class="btn btn-primary" href="/contact/">
          {site.ui.contact}
        </a>
        <a class="btn btn-secondary" href="/approach/">
          {site.ui.approach}
        </a>
      </div>
    </div>

    <Image
      class="hero-logo"
      src={logo}
      alt="Example page layout with a header, content cards, and an accent panel"
      widths={[320, 640, 960]}
      sizes="(max-width: 64rem) 70vw, 30rem"
      loading="eager"
      fetchpriority="high"
      data-reveal
      data-reveal-delay={`${(lines.length + 2) * 90}ms`}
    />
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-26) var(--space-18);
  }

  /* Two columns: the copy left, the mark right, vertically centred against the copy.
     The copy div is a real grid column, not a wrapper — the mark needs its own track. */
  .hero .container-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-12) var(--space-14);
    align-items: center;
  }

  .hero-logo {
    display: block;
    width: min(38vw, 30rem);
    min-width: 0;
    height: auto;
    /* Reserve a visible edge for the sample illustration in either theme. */
    border: var(--border-strong) solid var(--color-divider);
    box-shadow: var(--shadow-md);
  }

  .hero h1 {
    font-size: clamp(2.75rem, 1.5rem + 4vw, 4.75rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin: 0 0 var(--space-8);
    /* Optical alignment: the design pulls the headline left by roughly half a stem width
     * so the glyph edge lines up with the rules below it, not the glyph's side bearing. */
    margin-left: -0.058em;
  }

  .hero-line {
    display: block;
  }

  .hero-line-accent {
    color: var(--color-accent-ink);
  }

  .hero-lead :global(p) {
    font-size: 1.125rem;
    line-height: 1.66;
    max-width: 56ch;
    margin: 0 0 var(--space-7);
    color: color-mix(in srgb, var(--color-text) 82%, transparent);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  @media (max-width: 63.75rem) {
    .hero .container-page {
      grid-template-columns: 1fr;
    }
    .hero-logo {
      width: min(70vw, 26.25rem);
    }
  }

  @media (max-width: 45rem) {
    .hero {
      padding-block: var(--space-14) var(--space-12);
    }
  }
</style>
