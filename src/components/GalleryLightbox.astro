---
// A single shared photo viewer for the gallery page. Native <dialog> provides the modal
// semantics, the focus trap and Escape-to-close, and it restores focus to the thumbnail that
// opened it — so this stays accessible without hand-rolling any of that.
//
// Progressive enhancement: with no JavaScript the dialog never opens and the grid images stay
// exactly as they are, so nothing is hidden from anyone. The viewer reads its images straight
// from the tiles already in the page (each one's largest frame), so there is no second copy of
// the photography in the payload.
---

<dialog class="lightbox" aria-label="Photo viewer" data-lightbox-dialog>
  <div class="lightbox-stage">
    <figure class="lightbox-figure">
      <figcaption
        class="lightbox-caption"
        data-lightbox-caption
        aria-live="polite"
      ></figcaption>
    </figure>
    <div class="lightbox-controls">
      <button
        type="button"
        class="lightbox-btn"
        data-lightbox-prev
        aria-label="Previous photo"
      >
        <svg
          viewBox="0 0 24 24"
          width="24"
          height="24"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M15 5l-7 7 7 7"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
      <button
        type="button"
        class="lightbox-btn lightbox-btn-close"
        data-lightbox-close
        aria-label="Close photo viewer"
      >
        <svg
          viewBox="0 0 24 24"
          width="24"
          height="24"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M6 6l12 12M18 6L6 18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          />
        </svg>
      </button>
      <button
        type="button"
        class="lightbox-btn"
        data-lightbox-next
        aria-label="Next photo"
      >
        <svg
          viewBox="0 0 24 24"
          width="24"
          height="24"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M9 5l7 7-7 7"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
    </div>
  </div>
</dialog>

<style>
  .lightbox {
    inline-size: max-content;
    max-inline-size: 94vw;
    max-block-size: 92vh;
    margin: auto;
    padding: var(--space-4);
    border: 0;
    background: transparent;
    color: var(--color-text);
  }

  .lightbox::backdrop {
    background: color-mix(in srgb, var(--color-text) 84%, transparent);
  }

  .lightbox[open] {
    display: grid;
  }

  .lightbox-stage {
    display: grid;
    gap: var(--space-4);
    justify-items: center;
  }

  .lightbox-figure {
    margin: 0;
    display: grid;
    gap: var(--space-3);
    justify-items: center;
  }

  .lightbox-img {
    display: block;
    max-inline-size: min(92vw, 1000px);
    max-block-size: min(72vh, 999px);
    inline-size: auto;
    block-size: auto;
    object-fit: contain;
    background: var(--color-bg);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lg);
  }

  .lightbox-caption {
    padding: var(--space-2) var(--space-4);
    border-radius: 9999px;
    background: var(--color-bg);
    color: var(--color-text);
    font-size: var(--text-body-sm);
    text-align: center;
  }

  .lightbox-controls {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .lightbox-btn {
    display: grid;
    place-items: center;
    inline-size: 3rem;
    block-size: 3rem;
    border: 0;
    border-radius: 9999px;
    background: var(--color-accent-fill);
    color: var(--color-accent-on-fill);
    cursor: pointer;
  }

  .lightbox-btn:hover {
    background: var(--color-accent-ink);
    color: var(--color-bg);
  }

  .lightbox-btn:focus-visible {
    outline: 3px solid var(--color-bg);
    outline-offset: 2px;
  }

  .lightbox-btn-close {
    inline-size: 3.5rem;
    block-size: 3.5rem;
  }
</style>

<script>
  interface Frame {
    src: string;
    alt: string;
    label: string;
    total: number;
    /** The photo's own pixel size, so the viewer reserves the right box before decoding. */
    width: number;
    height: number;
  }

  let controller: AbortController | undefined;

  function wireLightbox() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const dialog = document.querySelector<HTMLDialogElement>(
      '[data-lightbox-dialog]',
    );
    if (!dialog || typeof dialog.showModal !== 'function') return;
    const figure = dialog.querySelector<HTMLElement>('.lightbox-figure');
    const caption = dialog.querySelector('[data-lightbox-caption]');
    const closeBtn = dialog.querySelector('[data-lightbox-close]');
    const prevBtn = dialog.querySelector('[data-lightbox-prev]');
    const nextBtn = dialog.querySelector('[data-lightbox-next]');
    if (!figure || !caption || !closeBtn || !prevBtn || !nextBtn) return;

    // The viewer's image is created at runtime and pointed at an already-optimised tile
    // frame, so it is not a content image and never sits in the markup as a raw image tag.
    // It is created on the first open rather than at wiring: an unopened dialog has no
    // business holding a dimensionless image in the document.
    let viewerImg: HTMLImageElement | undefined;

    let frames: Frame[] = [];
    let pos = 0;
    let lastTrigger: HTMLElement | null = null;

    // Use the largest frame the tile already ships (its srcset), so the viewer shows the
    // full-resolution file without the page carrying a second copy.
    const largestFrame = (tileImg: HTMLImageElement): string => {
      const srcset = tileImg.getAttribute('srcset');
      if (srcset) {
        let best = '';
        let bestWidth = -1;
        for (const part of srcset.split(',')) {
          const [url, descriptor] = part.trim().split(/\s+/);
          const width = parseInt(descriptor ?? '0', 10) || 0;
          if (url && width > bestWidth) {
            bestWidth = width;
            best = url;
          }
        }
        if (best) return best;
      }
      return tileImg.getAttribute('src') ?? '';
    };

    const render = () => {
      const frame = frames[pos];
      if (!frame || !viewerImg) return;
      viewerImg.src = frame.src;
      viewerImg.alt = frame.alt;
      // The tile carries the photo's real dimensions; hand them to the viewer too, so
      // the box is reserved before the picture decodes — CSS caps the size, the
      // attributes only supply the aspect ratio.
      if (frame.width > 0 && frame.height > 0) {
        viewerImg.width = frame.width;
        viewerImg.height = frame.height;
      } else {
        viewerImg.removeAttribute('width');
        viewerImg.removeAttribute('height');
      }
      caption.textContent = `${frame.label} — photo ${pos + 1} of ${frame.total}`;
      // Warm the neighbours so stepping feels instant.
      for (const offset of [-1, 1]) {
        const neighbour =
          frames[(pos + offset + frames.length) % frames.length];
        if (neighbour) new Image().src = neighbour.src;
      }
    };

    const step = (delta: number) => {
      pos = (pos + delta + frames.length) % frames.length;
      render();
    };

    const open = (trigger: HTMLElement) => {
      lastTrigger = trigger;
      if (!viewerImg) {
        viewerImg =
          figure.querySelector<HTMLImageElement>('.lightbox-img') ?? undefined;
        if (!viewerImg) {
          const created = document.createElement('img');
          created.className = 'lightbox-img';
          created.alt = '';
          figure.prepend(created);
          viewerImg = created;
        }
      }
      const group = trigger.getAttribute('data-group') ?? '';
      const selector = `[data-lightbox][data-group="${CSS.escape(group)}"]`;
      const tiles = Array.from(
        document.querySelectorAll<HTMLElement>(selector),
      );
      frames = tiles.map((tile) => {
        const tileImg = tile.querySelector('img');
        return {
          src: tileImg ? largestFrame(tileImg) : '',
          alt: tileImg?.getAttribute('alt') ?? '',
          label: tile.getAttribute('data-label') ?? '',
          total: Number(tile.getAttribute('data-total')) || tiles.length,
          width: Number(tileImg?.getAttribute('width')) || 0,
          height: Number(tileImg?.getAttribute('height')) || 0,
        };
      });
      const start = Number(trigger.getAttribute('data-index'));
      pos = Number.isFinite(start) ? start : 0;
      render();
      dialog.showModal();
    };

    document.addEventListener(
      'click',
      (event) => {
        const target = event.target;
        const trigger =
          target instanceof Element
            ? target.closest<HTMLElement>('[data-lightbox]')
            : null;
        if (trigger) {
          event.preventDefault();
          open(trigger);
        }
      },
      { signal },
    );

    prevBtn.addEventListener('click', () => step(-1), { signal });
    nextBtn.addEventListener('click', () => step(1), { signal });
    closeBtn.addEventListener('click', () => dialog.close(), { signal });

    // Click on the dimmed backdrop (not the image or controls) closes the viewer.
    dialog.addEventListener(
      'click',
      (event) => {
        if (event.target === dialog) dialog.close();
      },
      { signal },
    );

    dialog.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          step(1);
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault();
          step(-1);
        }
      },
      { signal },
    );

    // Always hand focus back to the thumbnail that opened the viewer, whether it closed on
    // Escape, the close button or a backdrop click.
    dialog.addEventListener(
      'close',
      () => {
        if (lastTrigger?.isConnected) lastTrigger.focus();
      },
      { signal },
    );
  }

  document.addEventListener('astro:page-load', wireLightbox);
  document.addEventListener('astro:before-swap', () => controller?.abort());
</script>
