---
import { getCollection } from 'astro:content';

// A figure/label pair list is a description list, not a grid of divs: each figure is the term
// and each label is its description. Screen readers announce the count and the pairing.
const outcomes = (await getCollection('outcomes')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<dl class="outcomes">
  {outcomes.map((entry, i) => (
    <div class="outcome" data-reveal data-reveal-delay={`${i * 80}ms`}>
      <dt
        class="outcome-figure"
        data-count-to={entry.data.countTo}
        data-count-final={entry.data.figure}
      >
        {entry.data.figure}
      </dt>
      <dd class="outcome-label">{entry.data.label}</dd>
    </div>
  ))}
</dl>

<style>
  .outcomes {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-8);
    margin: 0;
  }

  .outcome-figure {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-3);
    margin-left: -0.045em;
    color: var(--color-accent-ink);
    /* The count-up swaps digits; without this the label below shifts as the width changes. */
    font-variant-numeric: tabular-nums;
  }

  .outcome-label {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.55;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-text) 70%, transparent);
  }

  @media (max-width: 56.25rem) {
    .outcomes {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 30rem) {
    .outcomes {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
