---
import { Image } from 'astro:assets';
import { site } from '../site';
import NavLinks from './NavLinks.astro';
import BookingCallToAction from './BookingCallToAction.astro';
import logoBadge from '../assets/brand/logo.png';

// The one frame every page shares: brand, routes, phone, and the booking action.
//
// The wordmark is set as type rather than shipped as an image: it stays crisp at 200%
// text, it speaks to a screen reader as the business name, and it cannot be a low-resolution
// PNG on a phone. The previous site's masthead lettering collided at 400px, which is the
// failure this layout is built to avoid.
//
// Beside it sits the property's own logo badge — the real crest from the previous site,
// upscaled from its 193px original with transparent edges intact. It is decorative: the
// name is already the link's accessible name and the wordmark text, so the image carries
// an empty alt. An earlier generated flower badge was reverted for being wrong artwork
// and for crowding a single-row header; the two-row masthead (crest + name + booking,
// routes flush left on their own sticky row) is the previous site's familiar skeleton in
// this theme's clothes, and it is why the crest can finally be the anchor it was.
---

<header class="site-header">
  <a class="skip-link" href="#main">
    Skip to content
  </a>

  <div class="call-strip">
    <div class="container-page call-strip-inner">
      <p class="call-strip-text">{site.ui.callStrip}</p>
      <a class="call-strip-number" href={site.phone.href}>
        {site.phone.label}
      </a>
    </div>
  </div>

  <div class="masthead container-page">
    <a class="brand" href="/" aria-label={`${site.name} — home`}>
      <Image
        class="brand-logo"
        src={logoBadge}
        alt=""
        widths={[84, 168, 252]}
        sizes="84px"
        width="84"
        height="64"
        loading="eager"
        fetchpriority="high"
      />
      <span class="brand-word">
        <span class="brand-word-full">{site.name}</span>
        <span class="brand-word-short">{site.shortName}</span>
      </span>
    </a>

    <div class="masthead-end">
      <!-- The wrapper, not the button, is what the narrow-width rule hides: a scoped style
           in this file cannot reach the root element of a child component that carries its
           own scope, so hiding the child by class would silently do nothing. -->
      <span class="nav-booking">
        <BookingCallToAction />
      </span>
      <button
        type="button"
        class="nav-burger"
        aria-expanded="false"
        aria-controls="nav-sheet"
        aria-label={site.ui.openMenu}
        data-label-open={site.ui.openMenu}
        data-label-close={site.ui.closeMenu}
      >
        <svg
          viewBox="0 0 20 20"
          width="20"
          height="20"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M2 5h16M2 10h16M2 15h16"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile sheet. Rendered in the DOM rather than injected on open so it is present for
       assistive tech and works without waiting on JS; `hidden` keeps it out of the tree
       until it is asked for. It lives inside the sticky group on phones so opening it
       mid-page reveals it beside the pinned masthead, not off-screen at the document top. -->
  <div class="nav-sheet" id="nav-sheet" hidden>
    <NavLinks />
    <div class="nav-sheet-foot container-page">
      <BookingCallToAction />
      <a class="nav-sheet-call" href={site.phone.href}>
        {site.phone.label}
      </a>
    </div>
  </div>

  <!-- Desktop routes own a row, flush left on the content column and ruled like the
       page rules. The header sticks, and scrolling past the masthead condenses it to
       exactly this row (see the script), so the familiar full masthead greets you at
       the top and the permanent chrome mid-page is one slim strip. Below the
       breakpoint the row is gone and the sheet carries the same route list. -->
  <nav class="nav-row" aria-label="Primary">
    <div class="container-page nav-row-inner">
      <NavLinks class="nav-links" />
    </div>
  </nav>
</header>

<style>
  .site-header {
    /* Opaque: the previous theme laid navigation over translucent grey panels and body
       copy showing through, which is the legibility problem this replaces. The header
       sticks at every width. On desktop it condenses: scrolling past the masthead hides
       the strip and brand rows, leaving the route row pinned — the boundary is where the
       nav row reaches the top, so the collapse is invisible. Phones never condense (the
       script only sets the attribute beside a route row); their header is the original
       pinned masthead, and the open sheet simply grows it taller from within. */
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg);
    border-block-end: var(--border-width) solid var(--color-divider);
  }

  .skip-link {
    position: absolute;
    left: var(--space-2);
    top: var(--space-2);
    padding: var(--space-2) 0.875rem;
    background: var(--color-accent-fill);
    color: var(--color-accent-on-fill);
    font-weight: 700;
    font-size: var(--text-sm);
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }

  .call-strip {
    background: var(--color-accent-fill);
    color: var(--color-accent-on-fill);
    font-size: var(--text-sm);
  }

  .call-strip-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    padding-block: var(--space-2);
  }

  .call-strip-text {
    margin: 0;
    letter-spacing: 0.02em;
  }

  .call-strip-number {
    color: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.1875rem;
  }

  .masthead {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    /* Comforts the 64px crest without padding maths: content height plus breathing room. */
    min-block-size: 5.5rem;
  }

  /* Condensing is set by the script at desktop widths only; it is what leaves the route
     row as the entire pinned header mid-page. Placed after the rows it hides so plain
     selectors are not outranked by the compound ones above them. */
  .site-header[data-condensed] .call-strip,
  .site-header[data-condensed] .masthead {
    display: none;
  }

  /* Desktop: the route row is the part of the sticky header that survives condensing. */
  .nav-row {
    background: var(--color-bg);
    border-block: var(--border-width) solid var(--color-divider);
  }

  .nav-row-inner {
    display: flex;
    /* Routes sit flush with the content column, not centred: the row shares the page's
       left edge like every other block. The padding is the air the condensed header
       lives with, so it is measured in row padding, not link padding. */
    padding-block: var(--space-3);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-inline-end: auto;
    color: var(--color-accent-ink);
    text-decoration: none;
  }

  .brand-logo {
    /* Intrinsic 772×592 crest; the width/height attributes reserve 84×64 CSS px —
       the nav row gave the brand row its freedom, so the crest is the anchor of the
       masthead. Sizing lives on the element so the reservation cannot drift. */
    block-size: auto;
    inline-size: auto;
  }

  .brand-word {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1.05;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .brand-word-short {
    display: none;
  }

  :global(.nav-links) {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-links :global(a) {
    position: relative;
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--text-body);
    padding-block: var(--space-1);
  }

  /* The underline is the same hairline device the page rules use, and it also gives the
     current page a marker that does not depend on colour alone. */
  .nav-links :global(a)::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: var(--border-width);
    background: var(--color-accent-ink);
    transform: scaleX(0);
    transform-origin: left;
  }

  .nav-links :global(a):hover::after,
  .nav-links :global(a):focus-visible::after,
  .nav-links :global(a)[aria-current='page']::after {
    transform: scaleX(1);
  }

  .nav-links :global(a)[aria-current='page'] {
    color: var(--color-accent-ink);
    font-weight: 700;
  }

  .masthead-end {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .nav-burger {
    display: none;
    align-items: center;
    justify-content: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    padding: 0;
    color: var(--color-text);
    background: transparent;
    border: var(--border-width) solid var(--color-divider);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .nav-sheet {
    border-block-start: var(--border-width) solid var(--color-divider);
  }

  .nav-sheet :global(ul) {
    margin: 0;
    padding: var(--space-2) 0;
    list-style: none;
  }

  /* Only the route links get the sheet's own link style. The booking button and the phone
     link are anchored too, but they carry component styles (`.btn-primary`, `.nav-sheet-call`)
     that a bare `a` selector here would outrank — which is how the button ended up with body
     text instead of its white contrast colour. */
  .nav-sheet :global(ul a) {
    display: block;
    padding: var(--space-3) var(--space-5);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-title-sm);
    color: var(--color-text);
    text-decoration: none;
  }

  .nav-sheet :global(ul a)[aria-current='page'] {
    color: var(--color-accent-ink);
  }

  .nav-sheet-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-5) var(--space-8);
  }

  .nav-sheet-call {
    color: var(--color-accent-ink);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.1875rem;
  }

  @media (max-width: 80rem) {
    .nav-row {
      display: none;
    }
    .nav-burger {
      display: inline-flex;
    }
    .nav-booking {
      display: none;
    }
  }

  @media (max-width: 26.25rem) {
    .brand-word-full {
      display: none;
    }
    .brand-word-short {
      display: inline;
    }
    .call-strip-text {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav-links :global(a)::after {
      transition: transform 220ms var(--ease-out-quint);
    }

    .nav-sheet:not([hidden]) {
      animation: sheet-in 240ms var(--ease-out-quint) both;
    }

    @keyframes sheet-in {
      from {
        opacity: 0;
        transform: translateY(-0.5rem);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }

  /* Without JavaScript the sheet can never be opened, so the routes are shown inline
     instead - navigation stays available, it just stops being collapsible. */
  :global(html:not([data-js])) .nav-row {
    display: block;
  }
  :global(html:not([data-js]) .nav-links) {
    display: flex;
    flex-wrap: wrap;
  }
  :global(html:not([data-js])) .nav-burger {
    display: none;
  }
  :global(html:not([data-js]) .nav-sheet) {
    display: none;
  }

  @media (max-width: 28rem) {
    .masthead {
      flex-wrap: wrap;
      padding-block: var(--space-2);
    }
    .masthead-end {
      flex-wrap: wrap;
      min-inline-size: 0;
    }
  }
</style>

<script>
  let listeners: AbortController | undefined;

  function wireHeader() {
    listeners?.abort();
    listeners = new AbortController();
    const { signal } = listeners;
    const burger = document.querySelector<HTMLButtonElement>('.nav-burger');
    const sheet = document.querySelector<HTMLElement>('#nav-sheet');
    if (!burger || !sheet) return;

    // The labels travel on the button rather than being hardcoded here, so the wording
    // stays in site.ts with the rest of the shared copy. An inline global would need the
    // CSP to allow one, which is the trade this avoids.
    const openLabel = burger.dataset.labelOpen ?? 'Open menu';
    const closeLabel = burger.dataset.labelClose ?? 'Close menu';

    const setOpen = (open: boolean) => {
      sheet.hidden = !open;
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? closeLabel : openLabel);
    };

    burger.addEventListener('click', () => setOpen(sheet.hidden === true), {
      signal,
    });

    // Escape closes and returns focus to the control that opened it, otherwise focus is
    // left on a hidden element and the next Tab starts from the top of the document.
    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape' && !sheet.hidden) {
          setOpen(false);
          burger.focus();
        }
      },
      { signal },
    );

    // The sheet is the only navigation below the breakpoint. Resize past it without closing
    // the sheet and its open state survives: back below the breakpoint the next tap then
    // *closes* the panel that was never visibly open, so the menu reads as dead until a
    // refresh resets it. Closing on the way into the desktop width keeps the two states in
    // step, so the control behaves the same after a resize as after a load. The query mirrors
    // the header's own `max-width: 80rem` collapse, so it stays correct if that changes.
    const desktopNav = window.matchMedia('(min-width: 80rem)');
    const syncOnBreakpoint = (event: MediaQueryListEvent) => {
      if (event.matches && !sheet.hidden) setOpen(false);
    };
    desktopNav.addEventListener('change', syncOnBreakpoint, { signal });

    // Desktop condense: past the point where the route row reaches the top, the strip
    // and brand rows hide and the sticky header is exactly that row. The threshold is
    // measured, so the swap happens at the boundary where nothing moves on screen.
    // Phones opt out: their masthead group is the pinned thing already, and hiding it
    // would hide the only route into the sheet.
    const header = document.querySelector<HTMLElement>('.site-header');
    const navRow = document.querySelector<HTMLElement>('.nav-row');
    if (!header || !navRow) return;
    let condenseThreshold = 0;
    const measure = () => {
      condenseThreshold = Math.max(
        0,
        header.offsetHeight - navRow.offsetHeight,
      );
    };
    const syncCondensed = () => {
      if (desktopNav.matches && window.scrollY > condenseThreshold) {
        header.toggleAttribute('data-condensed', true);
      } else {
        header.removeAttribute('data-condensed');
      }
    };
    measure();
    syncCondensed();
    window.addEventListener('scroll', syncCondensed, { passive: true, signal });
    window.addEventListener(
      'resize',
      () => {
        measure();
        syncCondensed();
      },
      { signal },
    );
    desktopNav.addEventListener('change', syncCondensed, { signal });
  }

  document.addEventListener('astro:before-swap', () => listeners?.abort());
  document.addEventListener('astro:page-load', wireHeader);
</script>
