---
import { Image } from 'astro:assets';
import { site } from '../site';
import icon from '../assets/brand/mark.svg';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-page footer-inner">
    <p class="footer-line">
      <Image class="footer-mark" src={icon} alt="" width={20} height={20} />
      {site.name} — {site.ui.footer}
    </p>
    <ul class="footer-links">
      <li>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </li>
      <li>
        <a href="/about/">About</a>
      </li>
      <li>
        <a href="/contact/">Contact</a>
      </li>
    </ul>
    <p class="footer-fine">
      © {year} {site.name}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--border-strong) solid var(--color-divider);
    margin-top: auto;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3) var(--space-8);
    padding-block: var(--space-8) var(--space-10);
  }

  .footer-line {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0;
    font-size: var(--text-body-sm);
    font-weight: 800;
    font-family: var(--font-heading);
    margin-right: auto;
  }

  .footer-mark {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-body-sm);
  }

  .footer-fine {
    width: 100%;
    margin: 0;
    font-size: var(--text-xs);
    color: color-mix(in srgb, var(--color-text) 78%, transparent);
  }
</style>
